{
    "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",

    // Container properties
    "name": "Minecraft Forge Modification Boilerplate",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "DEBIAN_VARIANT": "bullseye",
            "JAVA_VERSION": "1-8"
        }
    },
    "postCreateCommand": "./gradlew genVSCodeRuns",
    "remoteUser": "minecraft",

    // Enabled features
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },

    // Customization options
    "customizations": {
        // Codespace options
        "codespaces": {
            "openFiles": [
                "README.md"
            ]
        },

        // Visual Studio Code options
        "vscode": {
            // Enabled extensions
            "extensions": [
                // Markdown
                "DavidAnson.vscode-markdownlint",

                // YAML
                "redhat.vscode-yaml"
            ],

            // Editor settings
            "settings": {
                // Files associations
                "files.associations": {
                    // Visual Studio Code files
                    "*.code-workspace": "jsonc",
                    ".vscode/*.json": "jsonc",

                    // Gradle scripts
                    "gradlew": "shellscript",

                    // Minecraft resources
                    "*.info": "json",
                    "*.mcmeta": "json",
                    "*.lang": "properties"
                },

                // Extensions settings
                "redhat.telemetry.enabled": false,

                // Formats settings
                "[yaml]": {
                    "editor.defaultFormatter": "redhat.vscode-yaml"
                },
                "[json]": {
                    "editor.defaultFormatter": "vscode.json-language-features"
                },
                "[markdown]": {
                    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
                }
            }
        }
    }
}
